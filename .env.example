# Порт веб-интерфейса и API на хосте
HTTP_PORT=8080
# Порт /metrics (Prometheus), открыт только на 127.0.0.1
METRICS_PORT=9090
# Пароль PostgreSQL (для локального запуска можно оставить)
POSTGRES_PASSWORD=credit-local
# Имитация времени обработки на каждом этапе конвейера (чтобы прогресс был виден в UI)
PIPELINE_STEP_DELAY=3s
# Режим: demo — локальный показ (публичный токен банка, cookie без Secure для http://localhost);
# production — секреты обязательны, cookie только по HTTPS, запуск с демо-токеном блокируется
APP_MODE=demo
# Токен для кабинета сотрудника банка (заголовок X-Bank-Token); в production — свой, от 16 символов
BANK_TOKEN=demo-bank
# Уровень логов: debug | info | warn | error
LOG_LEVEL=info
# Лимит запросов к API на IP: запросов в секунду и «запас» (burst)
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=60
